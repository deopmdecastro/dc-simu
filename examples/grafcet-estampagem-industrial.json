  "canvasNotes": [
    {
      "id": "est-n-auto",
      "text": "Como testar — automático",
      "view": "grafcet",
      "x": 2250,
      "y": 110,
      "color": "#bfdbfe",
      "messages": [
        {
          "id": "est-n-auto-m0",
          "text": "Emergencia e Modo_Auto ligados (já no arranque). Impulso em B_Start: G0 passa a X1 e o G2 arranca.",
          "author": "DC-SIMU",
          "createdAt": "2026-10-30T10:00:00.000Z"
        },
        {
          "id": "est-n-auto-m1",
          "text": "Peca_Presente → deteção. Escolha o tipo: Tipo_Preta / Tipo_Branca / Tipo_Metal e mantenha-o durante o ciclo.",
          "author": "DC-SIMU",
          "createdAt": "2026-10-30T10:00:00.000Z"
        },
        {
          "id": "est-n-auto-m2",
          "text": "Pos_Estampa → estampagem 5/6/8 s. Depois Pos_Deposito → gaveta e contagem; FC_Gaveta_* e FC_Origem fecham o ciclo.",
          "author": "DC-SIMU",
          "createdAt": "2026-10-30T10:00:00.000Z"
        },
        {
          "id": "est-n-auto-m3",
          "text": "Desligar Modo_Auto: o G0 vai a X2 (a terminar ciclo) e só volta à paragem quando o G2 chega ao repouso.",
          "author": "DC-SIMU",
          "createdAt": "2026-10-30T10:00:00.000Z"
        }
      ],
      "createdAt": "2026-11-06T00:00:00.000Z"
    },
    {
      "id": "est-n-manual",
      "text": "Como testar — manual e reset",
      "view": "grafcet",
      "x": 2250,
      "y": 350,
      "color": "#bbf7d0",
      "messages": [
        {
          "id": "est-n-manual-m0",
          "text": "Com o G0 parado, ligue Modo_Manual (desligue Modo_Auto): G0 → X3, o G4 → X51 e cada botão Man_* aciona o seu atuador.",
          "author": "DC-SIMU",
          "createdAt": "2026-10-30T10:00:00.000Z"
        },
        {
          "id": "est-n-manual-m1",
          "text": "Estampa e gavetas só atuam com Pos_Estampa / Pos_Deposito ativos (intertravamento).",
          "author": "DC-SIMU",
          "createdAt": "2026-10-30T10:00:00.000Z"
        },
        {
          "id": "est-n-manual-m2",
          "text": "B_Reset com o G0 parado: G0 → X4, o G3 repõe a origem (Retorno + zera contadores) até FC_Origem.",
          "author": "DC-SIMU",
          "createdAt": "2026-10-30T10:00:00.000Z"
        },
        {
          "id": "est-n-manual-m3",
          "text": "Endereços no formato byte.bit: C1_FC_8…15 da tabela física = I1.0…I1.7; manuais I2.0…I2.5; lâmpadas Q1.0…Q1.3.",
          "author": "DC-SIMU",
          "createdAt": "2026-10-30T10:00:00.000Z"
        }
      ],
      "createdAt": "2026-11-06T00:00:00.000Z"
    },
    {
