# Configuração do DC-SIMU

# Origem pública exata (origin) usada quando existe um proxy HTTPS.
PUBLIC_ORIGIN=http://localhost:3000
# Ative apenas atrás de um proxy reverso fiável que substitua X-Forwarded-*.
TRUST_PROXY=0

# Palavras-passe apenas para a primeira criação das contas SQLite do servidor.
# Defina valores únicos com pelo menos 16 caracteres, maiúsculas, minúsculas e números.
# Depois de criadas, as palavras-passe guardadas na base deixam de ser repostas no arranque.
ADMIN_INITIAL_PASSWORD=
USER_INITIAL_PASSWORD=

# ==============================================================================
# Base de Dados Supabase (PostgreSQL na Nuvem)
# ==============================================================================
# URL e chave publishable/anon podem ser partilhadas com o cliente; nunca use secret/service-role aqui.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Compatibilidade com projetos Supabase antigos:
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Segredo exclusivamente do servidor; nunca o exponha por VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Automação n8n (URLs/IDs públicos; credenciais apenas no servidor)
# ==============================================================================
VITE_N8N_URL=http://localhost:5678
VITE_N8N_WORKFLOW_ID=
VITE_N8N_WEBHOOK_URL=
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_WORKFLOW_ID=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/dcsimu-events
